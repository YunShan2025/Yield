{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Yield",
  "mainBinaryName": "有秋",
  "version": "1.1.1",
  "identifier": "com.yunshan.yield",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "有秋 · Yield",
        "width": 1240,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "transparent": true,
        "shadow": false,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "titleBarStyle": "Overlay",
        "visible": false,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      },
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://** http://localhost:** http://127.0.0.1:**",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "本地优先的个人成长与行动工具",
    "longDescription": "有秋（Yield）— 名取《尚书·盘庚》「若农服田力穑，乃亦有秋」：本地优先的个人成长与行动工具，让每一天的付出都有收成。",
    "copyright": "Copyright © 2026 有秋",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "有秋",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "macos/dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:app.db"
      ]
    }
  }
}